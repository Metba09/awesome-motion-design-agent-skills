# Copy to .env (setup.sh does it for you). Never commit .env.
# Sandbox session = offline: everything below is a mock default. No key is ever needed or read.

MOTION_OFFLINE=1
PROVIDER_MODE=mock

# Real provider keys. LEAVE EMPTY in the sandbox: no outbound calls to these services are possible.
# They are listed so you know which variables a real, networked run would require.
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
LUMA_API_KEY=
RUNWAYML_API_SECRET=
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
